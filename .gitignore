# Godot 4+ specific ignores
# === GODOT ===
.import/
.godot/
mono_crash.*
export.cfg
export_presets.cfg

# === C# / .NET ===
bin/
obj/
.mono/
*.exe
*.dll
*.pdb
*.mdb

# === IDEs y editores ===
.vscode/
.idea/
*.user
*.suo
*.tmp
*.log

# === Archivos del sistema ===
.DS_Store
Thumbs.db
desktop.ini

# === Backups ===
*.old
*.bak
*.tmp

# === Carpetas multimedia (solo estructura) ===
# Ignorar todo dentro de Assets
Assets/**
# Pero permitir que las carpetas existan con un marcador vacío
!Assets/**/.gitkeep

# === Carpetas de proyecto que sí deben subirse ===
!Scenes/**
!Scripts/**
!Prefabs/**
!Config/**
!project.godot
!*.tscn
!*.cs
!*.gd
!*.tres
!*.res

# Ignorar videos pesados
Assets/Video/*.ogv
Assets/Video/*.mp4
Assets/Audio/*.wav
Assets/Audio/*.mp3
